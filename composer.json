{
    "name": "mapcova/osm-addresses",
    "description": "The method used to build the United Kingdom and Ireland address databases from OpenStreetMap extracts (ODbL 1.0 section 4.6).",
    "type": "project",
    "license": "AGPL-3.0-only",
    "prefer-stable": true,
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-zlib": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.49",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MapCova\\OsmAddresses\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MapCova\\OsmAddresses\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    }
}
